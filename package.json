{
  "name": "wilderbots-site",
  "version": "1.0.0",
  "description": "Wilderbots - Pioneering wearable tech and interactive education",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); const path=require('path'); const nextDir=path.join(process.cwd(), '.next'); if(fs.existsSync(nextDir)) { fs.rmSync(nextDir, {recursive:true}); console.log('✓ Cleaned .next folder'); }\"",
    "dev": "npm run clean && node server.js",
    "build": "npm run clean && next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.38.0",
    "imap": "^0.8.19",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.294.0",
    "mailparser": "^3.9.0",
    "mongoose": "^9.0.1",
    "next": "^14.0.0",
    "nodemailer": "^7.0.11",
    "postcss": "^8.4.32",
    "razorpay": "^2.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0"
  }
}
