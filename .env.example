# Environment Variables for Wilderbots Site
# Copy this file to .env.local and fill in your actual values

# MongoDB Connection String
# Required for database connectivity
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=your-mongodb-connection-string-here

# JWT Secret Key
# Required for authentication token signing and verification
# IMPORTANT: Use a strong, random secret key in production
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-key-here

# Server Port
# Optional: Port number for the server (defaults to 3000 if not set)
PORT=3000

# Node Environment
# Optional: Set to 'production' for production builds, 'development' for dev mode
NODE_ENV=development
